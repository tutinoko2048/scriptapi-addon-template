{
  "name": "scriptapi-template",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@bedrock-apis/env-types": "1.0.0-rc.1",
    "@minecraft/server": "2.8.0-beta.1.26.21-stable",
    "@minecraft/server-ui": "2.1.0-beta.1.26.21-stable",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@minecraft/server": "$@minecraft/server"
  },
  "packageManager": "pnpm@11.5.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.2"
    }
  },
  "files": [
    "./manifest.json",
    "./scripts",
    "./LICENSE"
  ]
